<%- include('../partials/header') %>

<div class="page-header">
  <div>
    <h1 class="page-title">Admin Overview</h1>
    <p class="page-subtitle">Real-time financial tracking and group management</p>
  </div>
  <div class="btn-group">
    <a href="/admin/savings" class="btn btn-primary">+ Record Savings</a>
    <a href="/admin/members/add" class="btn btn-outline">+ Add Member</a>
  </div>
</div>

<!-- 6 KPI Stat Cards -->
<div class="stats-grid">
  <!-- Card 1: Total Group Savings -->
  <div class="stat-card">
    <div>
      <div class="stat-label">Total Group Savings</div>
      <div class="stat-value">₹<%= totalSavings.toLocaleString('en-IN') %></div>
    </div>
    <div class="stat-icon icon-green">💰</div>
  </div>

  <!-- Card 2: Loans Disbursed -->
  <div class="stat-card">
    <div>
      <div class="stat-label">Loans Disbursed</div>
      <div class="stat-value">₹<%= totalLoansDisbursed.toLocaleString('en-IN') %></div>
    </div>
    <div class="stat-icon icon-blue">🤝</div>
  </div>

  <!-- Card 3: Amount Recovered -->
  <div class="stat-card">
    <div>
      <div class="stat-label">Amount Recovered</div>
      <div class="stat-value">₹<%= amountRecovered.toLocaleString('en-IN') %></div>
    </div>
    <div class="stat-icon icon-teal">📈</div>
  </div>

  <!-- Card 4: Active Loans -->
  <div class="stat-card">
    <div>
      <div class="stat-label">Active Loans</div>
      <div class="stat-value"><%= activeLoansCount %></div>
    </div>
    <div class="stat-icon icon-amber">📝</div>
  </div>

  <!-- Card 5: Total Members -->
  <div class="stat-card">
    <div>
      <div class="stat-label">Total Members</div>
      <div class="stat-value"><%= totalMembersCount %></div>
    </div>
    <div class="stat-icon icon-purple">👥</div>
  </div>

  <!-- Card 6: Defaulters -->
  <div class="stat-card">
    <div>
      <div class="stat-label">Defaulters</div>
      <div class="stat-value" style="<%= defaultersCount > 0 ? 'color: var(--danger);' : '' %>">
        <%= defaultersCount %>
      </div>
    </div>
    <div class="stat-icon icon-red">⚠️</div>
  </div>
</div>

<!-- Defaulters Section -->
<div class="card">
  <div class="card-header">
    <h2 class="card-title">
      <span>⚠️ Defaulters Tracking</span>
      <% if (defaultersCount > 0) { %>
        <span class="badge badge-defaulter"><%= defaultersCount %> Overdue</span>
      <% } else { %>
        <span class="badge badge-paid">All Clear</span>
      <% } %>
    </h2>
    <small style="color: var(--text-muted);">Members with approved loans having unpaid past-due installments</small>
  </div>

  <% if (defaultersList && defaultersList.length > 0) { %>
    <div class="table-responsive">
      <table class="data-table">
        <thead>
          <tr>
            <th>Member Name</th>
            <th>Email</th>
            <th>Original Loan</th>
            <th>Pending Overdue Installments</th>
            <th>Overdue Amount</th>
            <th>Status</th>
            <th>Action</th>
          </tr>
        </thead>
        <tbody>
          <% defaultersList.forEach(item => { %>
            <tr>
              <td><strong><%= item.member.name %></strong></td>
              <td><%= item.member.email %></td>
              <td>₹<%= item.loan.amount.toLocaleString('en-IN') %></td>
              <td><span class="badge badge-defaulter"><%= item.pendingInstallments %> Overdue</span></td>
              <td><strong style="color: var(--danger);">₹<%= item.overdueAmount.toLocaleString('en-IN') %></strong></td>
              <td><span class="badge badge-defaulter">Defaulted</span></td>
              <td>
                <a href="/admin/repayments" class="btn btn-outline btn-sm">View Schedule</a>
              </td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
  <% } else { %>
    <div class="empty-state">
      <div class="empty-icon">🎉</div>
      <h3 class="empty-title">No Defaulters Found</h3>
      <p>All members have cleared their due installments on time.</p>
    </div>
  <% } %>
</div>

<!-- Quick Navigation & Evaluation Info -->
<div class="calc-box">
  <h4>💡 Evaluator Demonstration Tips</h4>
  <p style="font-size: 0.88rem; color: #065f46; margin-bottom: 0.5rem;">
    • <strong>Total Group Savings:</strong> Sum of all member savings contributions in MongoDB.<br>
    • <strong>Disbursed vs Recovered:</strong> Tracks total principal distributed vs installments collected.<br>
    • <strong>Defaulter Rule:</strong> A member is flagged when an installment's due date is before today and status is still <code>Pending</code>.
  </p>
</div>

<%- include('../partials/footer') %>
