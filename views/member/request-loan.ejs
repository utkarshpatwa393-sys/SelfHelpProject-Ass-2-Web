<%- include('../partials/header') %>

<div class="page-header">
  <div>
    <h1 class="page-title">Apply for a Micro-Loan</h1>
    <p class="page-subtitle">Submit a transparent loan request to your Self-Help Group</p>
  </div>
  <a href="/member/loans" class="btn btn-outline">&larr; Back to My Loans</a>
</div>

<div class="form-grid" style="grid-template-columns: 1.2fr 1fr; align-items: start;">
  <!-- Loan Application Form -->
  <div class="card">
    <div class="card-header">
      <h2 class="card-title">Loan Application Form</h2>
    </div>

    <form action="/member/loan/request" method="POST">
      <div class="form-group">
        <label for="loan-amount" class="form-label">Loan Amount (₹)</label>
        <input 
          type="number" 
          id="loan-amount" 
          name="amount" 
          class="form-input" 
          placeholder="e.g. 10000" 
          min="1000" 
          max="500000" 
          step="500" 
          required
        >
        <div class="form-help">Enter required principal amount in Rupees.</div>
      </div>

      <div class="form-group">
        <label for="loan-purpose" class="form-label">Loan Purpose</label>
        <input 
          type="text" 
          id="loan-purpose" 
          name="purpose" 
          class="form-input" 
          placeholder="e.g. Small business, Cattle purchase, Seeds & Fertilizers" 
          required
        >
      </div>

      <div class="form-group">
        <label for="loan-tenure" class="form-label">Repayment Tenure (in Months)</label>
        <input 
          type="number" 
          id="loan-tenure" 
          name="tenure" 
          class="form-input" 
          placeholder="e.g. 10" 
          min="1" 
          max="60" 
          required
        >
        <div class="form-help">Number of monthly installments for repayment.</div>
      </div>

      <button type="submit" class="btn btn-primary" style="width: 100%; margin-top: 1rem;">
        Submit Loan Request
      </button>
    </form>
  </div>

  <!-- Live EMI & Interest Calculator Preview -->
  <div class="card" style="background: #f0fdf4; border-color: #bbf7d0;">
    <div class="card-header">
      <h2 class="card-title" style="color: #065f46;">📊 Live EMI & Interest Breakdown</h2>
    </div>

    <p style="font-size: 0.85rem; color: #047857; margin-bottom: 1rem;">
      Interest is calculated transparently using the simple interest formula at a flat <strong>5% per annum</strong>.
    </p>

    <div style="display: flex; flex-direction: column; gap: 0.8rem;">
      <div style="display: flex; justify-content: space-between; padding: 0.5rem; background: #ffffff; border-radius: var(--radius-sm); border: 1px solid #d1fae5;">
        <span style="color: var(--text-muted);">Principal Amount:</span>
        <strong id="preview-principal">₹0</strong>
      </div>

      <div style="display: flex; justify-content: space-between; padding: 0.5rem; background: #ffffff; border-radius: var(--radius-sm); border: 1px solid #d1fae5;">
        <span style="color: var(--text-muted);">Annual Interest (5%):</span>
        <strong id="preview-interest" style="color: #047857;">₹0</strong>
      </div>

      <div style="display: flex; justify-content: space-between; padding: 0.5rem; background: #ffffff; border-radius: var(--radius-sm); border: 1px solid #d1fae5;">
        <span style="color: var(--text-muted);">Total Payable Amount:</span>
        <strong id="preview-total" style="color: var(--primary-dark);">₹0</strong>
      </div>

      <div style="display: flex; justify-content: space-between; padding: 0.75rem; background: #dcfce7; border-radius: var(--radius-sm); border: 1px solid #86efac;">
        <span style="font-weight: 600; color: #166534;">Est. Monthly Installment:</span>
        <strong id="preview-emi" style="color: #15803d; font-size: 1.15rem;">₹0</strong>
      </div>
    </div>

    <div style="font-size: 0.78rem; color: #047857; margin-top: 1rem; line-height: 1.4;">
      <em>Formula: Total = Principal + [Principal × 5% × (Tenure / 12)]</em>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
