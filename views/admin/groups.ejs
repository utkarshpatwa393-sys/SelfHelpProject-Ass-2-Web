<%- include('../partials/header') %>

<div class="page-header">
  <div>
    <h1 class="page-title">Self-Help Groups</h1>
    <p class="page-subtitle">Manage registered Self-Help Groups (SHGs)</p>
  </div>
</div>

<div class="form-grid" style="grid-template-columns: 1fr 1.6fr; align-items: start;">
  <!-- Create Group Form -->
  <div class="card">
    <div class="card-header">
      <h2 class="card-title">+ Create New Group</h2>
    </div>
    <form action="/admin/groups" method="POST">
      <div class="form-group">
        <label for="group-name" class="form-label">Group Name</label>
        <input 
          type="text" 
          id="group-name" 
          name="name" 
          class="form-input" 
          placeholder="e.g. Shakti Self Help Group" 
          required
        >
      </div>

      <div class="form-group">
        <label for="group-desc" class="form-label">Description</label>
        <textarea 
          id="group-desc" 
          name="description" 
          class="form-textarea" 
          rows="3" 
          placeholder="Brief description of the SHG and its purpose"
        ></textarea>
      </div>

      <button type="submit" class="btn btn-primary" style="width: 100%;">Create Group</button>
    </form>
  </div>

  <!-- Groups List -->
  <div class="card">
    <div class="card-header">
      <h2 class="card-title">Existing Groups (<%= groups.length %>)</h2>
    </div>

    <% if (groups && groups.length > 0) { %>
      <div class="table-responsive">
        <table class="data-table">
          <thead>
            <tr>
              <th>Group Name</th>
              <th>Description</th>
              <th>Created Date</th>
            </tr>
          </thead>
          <tbody>
            <% groups.forEach(g => { %>
              <tr>
                <td><strong><%= g.name %></strong></td>
                <td><%= g.description || 'No description provided' %></td>
                <td><%= new Date(g.createdAt).toLocaleDateString('en-IN') %></td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    <% } else { %>
      <div class="empty-state">
        <div class="empty-icon">📁</div>
        <h3 class="empty-title">No Groups Created Yet</h3>
        <p>Use the form on the left to create the first SHG.</p>
      </div>
    <% } %>
  </div>
</div>

<%- include('../partials/footer') %>
