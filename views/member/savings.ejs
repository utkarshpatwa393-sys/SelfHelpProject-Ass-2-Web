<%- include('../partials/header') %>

<div class="page-header">
  <div>
    <h1 class="page-title">Savings Passbook</h1>
    <p class="page-subtitle">Your complete monthly deposit record</p>
  </div>
  <a href="/member/dashboard" class="btn btn-outline">&larr; Back to Dashboard</a>
</div>

<div class="card">
  <div class="card-header">
    <h2 class="card-title">Monthly Contributions History</h2>
    <span class="badge badge-approved"><%= savingsList.length %> Deposits</span>
  </div>

  <% if (savingsList && savingsList.length > 0) { %>
    <div class="table-responsive">
      <table class="data-table">
        <thead>
          <tr>
            <th>Month</th>
            <th>Year</th>
            <th>Amount Deposited</th>
            <th>Deposit Date</th>
          </tr>
        </thead>
        <tbody>
          <% savingsList.forEach(s => { %>
            <tr>
              <td><strong><%= s.month %></strong></td>
              <td><%= s.year %></td>
              <td><strong style="color: var(--primary);">₹<%= s.amount.toLocaleString('en-IN') %></strong></td>
              <td><%= new Date(s.createdAt).toLocaleDateString('en-IN') %></td>
            </tr>
          <% }); %>
        </tbody>
        <tfoot>
          <tr>
            <td colspan="2"><strong>Total Lifetime Savings:</strong></td>
            <td colspan="2">
              <strong style="color: var(--primary); font-size: 1.15rem;">₹<%= totalSavings.toLocaleString('en-IN') %></strong>
            </td>
          </tr>
        </tfoot>
      </table>
    </div>
  <% } else { %>
    <div class="empty-state">
      <div class="empty-icon">🪙</div>
      <h3 class="empty-title">No Savings Recorded Yet</h3>
      <p>Your group administrator will record your monthly savings deposits here.</p>
    </div>
  <% } %>
</div>

<div class="calc-box">
  <h4>💡 Passbook Summary</h4>
  <p style="font-size: 0.88rem; color: #065f46;">
    Every member's monthly savings are securely saved in MongoDB and calculated in real-time to maintain full financial transparency.
  </p>
</div>

<%- include('../partials/footer') %>
